classDiagram

    class Biblioteca {
        +MAXIMO_PRESTAMO: int$
        +NUM_MAXIMO_LIBROS_PRESTADOS: int$
    }

    class Libro{
        -nombre: String,
        -tipo: TipoLibroEnum,
        -editorial: String,
        -ano: int
    }

    class Autor{
        -nombre: String,
        -nacionalidad: String,
        -fechaNacimiento: Date
    }

    class Copia{
        -id: int,
        -estado: EstadoCopiaEnum
    }

    class Lector {
        -diaMulta: Date,
        -diaMultado: int
    }

    class Prestamo {
        -fechaInicio: Date
        -fechaDevolucion: Date
    }

    note for Copia "<strong>EstadoCopiaEnum</strong>PRESTADA<br>CON_ATRASO<br>EN_PREPARACION<br>"
    note for Libro "<strong>TipoLibroEnum</strong>NOVELA<br>TEATRO<br>POESIA<br>ENSAYO"

    Libro "1:N" --* "1" Autor : Escribe
    Copia --|> Libro
    Libro "1" --* "1:N" Copia
    Lector "1" --o "1:N" Prestamo
    Copia "1" --o "1:N" Prestamo
    Libro *-- Biblioteca
    copia *-- Biblioteca